---
config:
  layout: elk
  look: handDrawn
  theme: neo
---
flowchart TD
 subgraph GGP["getGravitationalParameter(bodyKey)"]
    direction TB
        g_start(["start"])
        g_hasBody{"planetData[bodyKey] exists?"}
        g_checkOrbitParam{"bodyData.orbit.gravitationalParameter exists?"}
        g_returnOrbitParam["Return orbit.gravitationalParameter"]
        g_checkCentral@{ label: "centralBody == 'sun' ? 'earthMoonBarycenter' ?" }
        g_returnSun["Return GM_SUN"]
        g_returnEMB["Return GM_EARTH_MOON"]
        g_default["Return GM_SUN (default)"]
        g_end(["end"])
  end
 subgraph ISB["isBarycenter(bodyKey)"]
    direction TB
        i_start(["start"])
        i_check{"planetData[bodyKey]?.isBarycenter === true?"}
        i_returnTrue["Return true"]
        i_returnFalse["Return false"]
        i_end(["end"])
  end
 subgraph GDR["getDisplayRadius() (instance)"]
    direction TB
        d_start(["start"])
        d_calc["pixels = Math.max(2, Math.log10(this.mass / 1e20) * 2)"]
        d_return["Return pixels"]
        d_end(["end"])
  end
 subgraph GWR["getWorldRadius() (instance)"]
    direction TB
        w_start(["start"])
        w_calc["meters = this.radius * 1000"]
        w_return["Return meters"]
        w_end(["end"])
  end
    BodyClass["Body (class)"] --> StaticProps@{ label: "<div style=\"width:500px; white-space:pre-wrap; text-align:left; font-size:12px\">Static properties<br>AU, G, GM_SUN, GM_EARTH_MOON Static Maps<br>planetData <br> <br>    planet: {<br>            name: 'Mercury',<br>            mass: 3.302e23, // in kg<br>            radius: 2439.4, // in km<br>            color: 'gray', <br>            SOI: 1.1e7, // in meters<br>            priority: 1, // High priority for rendering<br>            spritePath: 'Mercury.png', // Path to sprite image<br>            orbit: {<br>                semiMajorAxis: 0.387 * Body.AU, // in meters<br>                eccentricity: 0.206, // unitless<br>                inclination: 7.005 * (Math.PI / 180), // in radians<br>                longitudeOfAscendingNode: 48.331 * (Math.PI / 180), // in radians<br>                argumentOfPeriapsis: 29.124 * (Math.PI / 180), // in radians<br>                meanAnomalyAtEpoch: 174.796 * (Math.PI / 180), // in radians<br>                epochTime: 0, // This means that at time 0, the position corresponds to the above elements<br>                centralBody: 'sun' // central body name<br>            }<br>            isBarycenter: false //flag for identitty of the object<br>            }<br>            //continue for sun, and the rest of the planets, Earth's moon and the earth-moon barycenter" } & GGP & ISB & GWR & GDR
    g_start --> g_hasBody
    g_hasBody -- Yes --> g_checkOrbitParam
    g_checkOrbitParam -- Yes --> g_returnOrbitParam
    g_returnOrbitParam --> g_end
    g_checkOrbitParam -- No --> g_checkCentral
    g_checkCentral -- sun --> g_returnSun
    g_returnSun --> g_end
    g_checkCentral -- earthMoonBarycenter --> g_returnEMB
    g_returnEMB --> g_end
    g_checkCentral -- other --> g_default
    g_default --> g_end
    g_hasBody -- No --> g_default
    i_start --> i_check
    i_check -- Yes --> i_returnTrue
    i_returnTrue --> i_end
    i_check -- No --> i_returnFalse
    i_returnFalse --> i_end
    d_start --> d_calc
    d_calc --> d_return
    d_return --> d_end
    w_start --> w_calc
    w_calc --> w_return
    w_return --> w_end
    StaticProps --> GGP & GDR & GWR & ISB
    g_checkCentral@{ shape: diamond}
    StaticProps@{ shape: rect}
     BodyClass:::classBox
     StaticProps:::staticBox
     StaticProps:::staticBox
    classDef classBox fill:#eef6ff,stroke:#2b6fb2,stroke-width:2px
    classDef staticBox fill:#fff8e1,stroke:#dba300
    classDef mapsBox fill:#fff0f6,stroke:#c2255c
    classDef funcBox fill:#f6fff4,stroke:#1f8a5f
    style StaticProps width:6000px,height:260px
